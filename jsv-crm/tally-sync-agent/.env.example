# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file or share the service role key —
# it has full write access to your database.

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase SERVICE ROLE key (Settings → API → service_role secret)
# This is different from the anon key the CRM website uses — it's needed
# here because this script writes data directly, with no logged-in user.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Tally's local XML/HTTP server. Default port is 9000 and this script
# is meant to run on the SAME PC as Tally, so localhost is correct.
TALLY_URL=http://localhost:9000

# Exact company name as it appears inside Tally (Gateway of Tally, top
# left). Leave blank to use whichever company Tally currently has open.
TALLY_COMPANY=

# How many days back to re-check on every poll. 1 is usually enough —
# it re-checks "today" each time so same-day edits in Tally still sync,
# and never inserts duplicates because invoice numbers are checked
# against the CRM before inserting.
SYNC_DAYS_BACK=1

# How often to check Tally for new invoices, in seconds.
POLL_INTERVAL_SECONDS=60

# ── Two-way sync: pushing CRM invoices back INTO Tally ──────────────
# Set to false to disable pushing altogether and keep this agent
# pull-only (Tally → CRM), same as before.
PUSH_TO_TALLY=true

# These MUST match ledger names that already exist in your Tally
# company's chart of accounts, character for character, or Tally will
# reject the voucher. Ask your accountant/Tally operator for the exact
# names if you're not sure.
TALLY_SALES_LEDGER=Sales
TALLY_CGST_LEDGER=CGST
TALLY_SGST_LEDGER=SGST
TALLY_IGST_LEDGER=IGST

# Max invoices to push to Tally in a single poll (keeps one slow/bad
# Tally response from blocking everything else).
PUSH_BATCH_LIMIT=25
