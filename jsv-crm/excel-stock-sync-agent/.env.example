# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file or share the service role key —
# it has full write access to your database.

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://xxxxx.supabase.co

# Supabase SERVICE ROLE key (Settings → API → service_role secret)
# This is different from the anon key the CRM website uses — it's needed
# here because this script writes data directly, with no logged-in user.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Full path to the stock Excel/CSV file on THIS pc, e.g.:
#   Windows local file:    C:\Stock\stock.xlsx
#   Windows shared folder: \\OFFICE-PC\Shared\stock.xlsx
#   Mapped network drive:  Z:\Stock\stock.xlsx
STOCK_FILE_PATH=C:\Stock\stock.xlsx

# Which sheet (tab) inside the workbook to read. Leave blank to use
# whichever sheet is first in the file.
SHEET_NAME=

# How often to double-check the file, in seconds, as a safety net.
# The agent also reacts instantly to file saves, but on some Windows
# network/shared drives "instant" file-change notifications don't fire
# reliably, so this poll is a backup that always catches changes within
# this interval either way.
POLL_INTERVAL_SECONDS=30

# Whether to also write an entry to the Inventory "movement history"
# (Stock > History) for every quantity change picked up from the file,
# so changes coming from Excel are traceable just like manual entries.
# Set to false if you only want the current on-hand quantity updated.
LOG_MOVEMENTS=true
